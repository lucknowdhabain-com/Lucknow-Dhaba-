        "status": "string",
        "deliveryPin": "string",
        "deliveryAddress": "object",
        "paymentMethod": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "allow": {
        "read": "request.auth.uid == resource.data.userId",
